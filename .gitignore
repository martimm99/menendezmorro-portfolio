# Claude Code local settings (per-machine)
.claude/settings.local.json

# Everything under public/ is generated by scripts/build.js (see its
# own header comment for the full list) except the static files it
# explicitly preserves — ignore everything, then un-ignore just those.
# An allowlist here instead of naming every generated per-project route
# individually means a new/renamed/deleted project can never be
# accidentally committed (or left orphaned in this file) just because
# nobody remembered to update this list to match content/projects.json.
# This list must match STATIC_PUBLIC_ENTRIES in scripts/build.js
# (cleanPublic) — the two can't share one source (git config vs. JS),
# so if one changes, update the other too.
public/*
!public/404.html
!public/CNAME
!public/_redirects
!public/robots.txt
!public/admin/
